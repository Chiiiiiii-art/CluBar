# Database (Supabase: Runtime port 6543 with Transaction Pooler, Migration port 5432 Direct)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clubar"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/clubar"

# Auth.js & Bootstrap Admin
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
OTP_HASH_PEPPER="replace-with-random-pepper"
ADMIN_EMAILS="admin@clubar.edu.tw"

# Dev-only quick seeded-account login (MUST be false or omitted in production)
ENABLE_DEV_LOGIN="true"

# AI Layer (Azure OpenAI default / OpenRouter hot-swap: Chat / Vision / Embedding)
AI_CHAT_PROVIDER="azure"
AI_VISION_PROVIDER="azure"
AI_EMBEDDING_PROVIDER="azure"
AI_CHAT_TIMEOUT_MS="8000"
AI_VISION_TIMEOUT_MS="12000"
AI_EMBEDDING_TIMEOUT_MS="4000"

AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_CHAT_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_VISION_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"

OPENROUTER_API_KEY=""
OPENROUTER_CHAT_MODEL="deepseek/deepseek-v4.1-flash"
OPENROUTER_VISION_MODEL="openai/gpt-4o-mini"
OPENAI_COMPAT_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_COMPAT_EMBEDDING_MODEL="openai/text-embedding-3-small"

# Azure Blob Storage (Public media + Private evaluation archive)
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONTAINER_NAME="clubar-media"
AZURE_STORAGE_PRIVATE_CONTAINER_NAME="clubar-private-archive"
AZURE_STORAGE_PUBLIC_BASE_URL="https://<account>.blob.core.windows.net/clubar-media"

# Email (.edu.tw OTP & Web Push fallback)
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="noreply@clubar.example.com"

# Web Push (VAPID keys: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:noreply@clubar.example.com"

# Personal webcal:// token & P1 long-tail reach HMAC salt (>=32 bytes random)
CALENDAR_TOKEN_SECRET=""
LONGTAIL_REACH_SALT=""
